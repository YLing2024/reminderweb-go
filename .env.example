# reminderweb-go 环境变量示例。真实部署把本文件拷贝到 /etc/reminderweb-go/reminderweb.env。
# 源码与示例里只允许出现 example.com / 127.0.0.1，真实域名与口令由部署环境注入。

# 监听地址与端口：只监听回环，对外由 nginx 反代。
HOST=127.0.0.1
PORT=19240

# 存储一律 MySQL。要么用下面 5 个分量，要么用一条 DB_DSN 整体覆盖（DB_DSN 优先）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reminderweb
DB_USER=reminderweb
# 口令只在此处与部署环境出现，绝不进仓库、日志或错误信息。
DB_PASSWORD=
# 可选：完整 DSN，形如 user:pass@tcp(127.0.0.1:3306)/reminderweb；非空时忽略上面的分量。
# 时间字段一律 bigint，无需 parseTime。
DB_DSN=

# 可选 YAML 配置文件；留空则只读环境变量。
CONFIG_FILE=

# 管理面认证模式：builtin（自带口令 + 登录页）/ sso（只认 X-Auth-User）/ none（本机开发）。
AUTH_MODE=builtin
AUTH_USER=admin
# 留空则首次启动生成一次性随机口令并只打印一次；生产请显式设置强口令。
AUTH_PASSWORD=
SESSION_TTL_DAYS=30
LOGIN_RATE_LIMIT=5

# 是否由后端直接托管前端产物（dist）。
SERVE_STATIC=1
# 部署形态：分离部署时用 CORS 白名单列出前端来源；留空 = 不启用跨域。
ALLOWED_ORIGINS=
# 会话 Cookie 的 SameSite：同源 lax；前后端分离且跨站时用 none（必须配合 HTTPS）。
COOKIE_SAMESITE=lax
TRUST_PROXY=1
LOG_LEVEL=info

# WebDAV 双向同步（均为「首次默认值」，之后以库内设置页的值为准）。
WEBDAV_ENABLED=0
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_INTERVAL_MINUTES=10
WEBDAV_DEBOUNCE_SECONDS=60
WEBDAV_ENCRYPT=1
WEBDAV_KEEP=10
WEBDAV_TIMEOUT_SECONDS=20
# 客户端模式下是否允许把 WebDAV 转发请求指向内网地址的首次默认值（默认关）。
WEBDAV_RELAY_ALLOW_PRIVATE=0
