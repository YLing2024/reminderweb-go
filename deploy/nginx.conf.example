# reminderweb-go 反向代理示例。占位域名与端口按部署实际替换。
# 后端只监听 127.0.0.1:19240，本文负责 TLS 终止与对外发布。
#
# 注意：__Host- 前缀的会话 Cookie 要求浏览器以 HTTPS 访问，因此对外必须是 https。

server {
    listen 443 ssl;
    server_name reminder.example.com;

    ssl_certificate     /etc/letsencrypt/live/reminder.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reminder.example.com/privkey.pem;

    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:19240;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebDAV 转发会用到这些动词与非标头。
        proxy_set_header Depth $http_depth;
        proxy_set_header Destination $http_destination;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }
}

server {
    listen 80;
    server_name reminder.example.com;
    return 301 https://$host$request_uri;
}
